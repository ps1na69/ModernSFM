---
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-braces-around-statements

WarningsAsErrors: ''
HeaderFilterRegex: '.*(include|src)/.*'
FormatStyle: file
